VIEW ReturnsService_AuditLog AS SELECT
  ReturnAuditLog_0.ID,
  ReturnAuditLog_0.createdAt,
  ReturnAuditLog_0.createdBy,
  ReturnAuditLog_0.modifiedAt,
  ReturnAuditLog_0.modifiedBy,
  ReturnAuditLog_0.invoiceNumber,
  ReturnAuditLog_0.proposedAction,
  ReturnAuditLog_0.approvalStatus,
  ReturnAuditLog_0.decidedAt,
  ReturnAuditLog_0.sapDocument
FROM o2c_ReturnAuditLog AS ReturnAuditLog_0