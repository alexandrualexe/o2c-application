COLUMN TABLE o2c_ReturnAuditLog (
  ID NVARCHAR(36) NOT NULL,
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  invoiceNumber NVARCHAR(10) NOT NULL,
  proposedAction NVARCHAR(20) NOT NULL,
  approvalStatus NVARCHAR(20) DEFAULT 'PENDING',
  decidedAt TIMESTAMP,
  sapDocument NVARCHAR(10),
  PRIMARY KEY(ID)
)